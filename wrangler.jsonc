{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeffreypotts",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Plain settings live here, not in the dashboard: a deploy removes
  // dashboard variables that aren't listed in this file. Secrets are
  // unaffected. .dev.vars overrides these for local testing.
  "vars": {
    "FROM_EMAIL": "Jeffrey Potts <me@jeffreypotts.ca>",
    "NOTIFY_EMAIL": "Jeffrey Potts <me@jeffreypotts.ca>",
    "MAILING_ADDRESS": "PO Box 7750, Picton, Ontario",
    // Hostnames Turnstile tokens may come from
    "TURNSTILE_HOSTNAMES": "jeffreypotts.ca,www.jeffreypotts.ca"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeffreypotts-newsletter",
      "database_id": "339b4808-2fcf-4d9a-b69b-ee5a66b758f5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "jeffreypotts-files"
    }
  ]
}
